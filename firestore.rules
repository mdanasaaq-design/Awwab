rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      // Root profile fields are backend-owned until a validated profile-edit API exists.
      allow read: if isOwner(uid);
      allow create, update, delete: if false;

      match /devices/{deviceId} {
        allow read: if isOwner(uid);
        allow create, update, delete: if false;
      }

      match /projects/{projectId} {
        allow read, create, update, delete: if isOwner(uid);
      }

      match /tasks/{taskId} {
        allow read, create, update, delete: if isOwner(uid);
      }

      match /conversations/{conversationId} {
        // Conversation history is persisted by trusted backend code so clients
        // cannot forge assistant/tool messages or mutate conversation metadata.
        allow read: if isOwner(uid);
        allow create, update, delete: if false;

        match /messages/{messageId} {
          allow read: if isOwner(uid);
          allow create, update, delete: if false;
        }
      }

      match /memories/{memoryId} {
        // The owner may inspect and delete memory, but provenance/classification
        // and content updates must pass through a validated backend path.
        allow read, delete: if isOwner(uid);
        allow create, update: if false;
      }

      match /automations/{automationId} {
        // Automation definitions can cause side effects; clients are read-only
        // until a validated mutation API and schema are defined.
        allow read: if isOwner(uid);
        allow create, update, delete: if false;
      }

      match /approvals/{approvalId} {
        // Approval records are created and transitioned by trusted backend code.
        allow read: if isOwner(uid);
        allow create, update, delete: if false;
      }

      match /activity/{activityId} {
        // Audit/activity records are append-oriented and backend-controlled.
        allow read: if isOwner(uid);
        allow create, update, delete: if false;
      }

      match /preferences/{preferenceId} {
        // Keep preferences read-only until their schema and mutation contract exist.
        allow read: if isOwner(uid);
        allow create, update, delete: if false;
      }

      match /notifications/{notificationId} {
        allow read: if isOwner(uid);
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"])
          && request.resource.data.read is bool;
        allow create, delete: if false;
      }
    }

    // Default deny for anything outside the user hierarchy.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
