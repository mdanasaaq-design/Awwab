rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validStringList(values, maxItems, maxLength) {
      return values is list
        && values.size() <= maxItems
        && (values.size() == 0
          ? true
          : (values[0] is string && values[0].size() <= maxLength))
        && (values.size() <= 1
          ? true
          : (values[1] is string && values[1].size() <= maxLength))
        && (values.size() <= 2
          ? true
          : (values[2] is string && values[2].size() <= maxLength))
        && (values.size() <= 3
          ? true
          : (values[3] is string && values[3].size() <= maxLength))
        && (values.size() <= 4
          ? true
          : (values[4] is string && values[4].size() <= maxLength));
    }

    function validProject(data) {
      return data.keys().hasOnly([
          "name", "description", "repositoryReferences", "status",
          "tags", "createdAt", "updatedAt"
        ])
        && data.keys().hasAll(["name", "status", "createdAt", "updatedAt"])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 160
        && data.status in ["active", "archived"]
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!("description" in data)
          || (data.description is string && data.description.size() <= 4000))
        && (!("tags" in data)
          || validStringList(data.tags, 5, 64))
        && (!("repositoryReferences" in data)
          || validStringList(data.repositoryReferences, 5, 500));
    }

    function validTask(data) {
      return data.keys().hasOnly([
          "title", "description", "status", "priority", "dueAt",
          "projectId", "createdAt", "updatedAt", "completedAt", "source"
        ])
        && data.keys().hasAll([
          "title", "status", "priority", "createdAt", "updatedAt", "source"
        ])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 200
        && data.status in ["todo", "in_progress", "done", "blocked", "cancelled"]
        && data.priority in ["low", "medium", "high", "urgent"]
        && data.source in ["user", "assistant"]
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!("description" in data)
          || (data.description is string && data.description.size() <= 4000))
        && (!("dueAt" in data)
          || data.dueAt == null || data.dueAt is timestamp)
        && (!("projectId" in data)
          || data.projectId == null || data.projectId is string)
        && (!("completedAt" in data)
          || data.completedAt == null || data.completedAt is timestamp);
    }

    match /users/{uid} {
      // Root profile fields are backend-owned until a validated profile-edit API exists.
      allow read: if isOwner(uid);
      allow create, update, delete: if false;

      match /devices/{deviceId} {
        allow read: if isOwner(uid);
        allow create, update, delete: if false;
      }

      match /projects/{projectId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && validProject(request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if isOwner(uid)
          && validProject(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;
        allow delete: if isOwner(uid);
      }

      match /tasks/{taskId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && validTask(request.resource.data)
          && request.resource.data.source == "user"
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if isOwner(uid)
          && validTask(request.resource.data)
          && request.resource.data.source == resource.data.source
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;
        allow delete: if isOwner(uid);
      }

      match /conversations/{conversationId} {
        // Conversation history is persisted by trusted backend code so clients
        // cannot forge assistant/tool messages or mutate conversation metadata.
        allow read: if isOwner(uid);
        allow create, update, delete: if false;

        match /messages/{messageId} {
          allow read: if isOwner(uid);
          allow create, update, delete: if false;
        }
      }

      match /memories/{memoryId} {
        // The owner may inspect and delete memory, but provenance/classification
        // and content updates must pass through a validated backend path.
        allow read, delete: if isOwner(uid);
        allow create, update: if false;
      }

      match /automations/{automationId} {
        // Automation definitions can cause side effects; clients are read-only
        // until a validated mutation API and schema are defined.
        allow read: if isOwner(uid);
        allow create, update, delete: if false;
      }

      match /approvals/{approvalId} {
        // Approval records are created and transitioned by trusted backend code.
        allow read: if isOwner(uid);
        allow create, update, delete: if false;
      }

      match /activity/{activityId} {
        // Audit/activity records are append-oriented and backend-controlled.
        allow read: if isOwner(uid);
        allow create, update, delete: if false;
      }

      match /preferences/{preferenceId} {
        // Keep preferences read-only until their schema and mutation contract exist.
        allow read: if isOwner(uid);
        allow create, update, delete: if false;
      }

      match /notifications/{notificationId} {
        allow read: if isOwner(uid);
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"])
          && request.resource.data.read is bool;
        allow create, delete: if false;
      }
    }

    // Default deny for anything outside the user hierarchy.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
