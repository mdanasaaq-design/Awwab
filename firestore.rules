rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validProject(data) {
      return data.keys().hasOnly([
          "name", "description", "repositoryReferences", "status",
          "tags", "createdAt", "updatedAt"
        ])
        && data.keys().hasAll(["name", "status", "createdAt", "updatedAt"])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 160
        && data.status in ["active", "archived"]
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!("description" in data)
          || (data.description is string && data.description.size() <= 4000))
        && (!("tags" in data)
          || (data.tags is list && data.tags.size() <= 20))
        && (!("repositoryReferences" in data)
          || (data.repositoryReferences is list && data.repositoryReferences.size() <= 20));
    }

    function validTask(data) {
      return data.keys().hasOnly([
          "title", "description", "status", "priority", "dueAt",
          "projectId", "createdAt", "updatedAt", "completedAt", "source"
        ])
        && data.keys().hasAll([
          "title", "status", "priority", "createdAt", "updatedAt", "source"
        ])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 200
        && data.status in ["todo", "in_progress", "done", "blocked", "cancelled"]
        && data.priority in ["low", "medium", "high", "urgent"]
        && data.source in ["user", "assistant"]
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!("description" in data)
          || (data.description is string && data.description.size() <= 4000))
        && (!("dueAt" in data)
          || data.dueAt == null || data.dueAt is timestamp)
        && (!("projectId" in data)
          || data.projectId == null || data.projectId is string)
        && (!("completedAt" in data)
          || data.completedAt == null || data.completedAt is timestamp);
    }

    function validMemory(data) {
      return data.keys().hasOnly([
          "content", "type", "sourceKind", "sourceRef", "confidence",
          "sensitivity", "createdAt", "updatedAt", "expiresAt",
          "userVisible", "confirmedByUser"
        ])
        && data.keys().hasAll([
          "content", "type", "sourceKind", "sourceRef", "confidence",
          "sensitivity", "createdAt", "updatedAt", "expiresAt",
          "userVisible", "confirmedByUser"
        ])
        && data.content is string
        && data.content.size() > 0
        && data.content.size() <= 2000
        && data.type in [
          "explicit_preference", "stable_profile_fact", "goal_commitment",
          "project_context", "learned_preference", "temporary_context"
        ]
        && data.sourceKind in ["user_explicit", "user_corrected"]
        && (data.sourceRef == null
          || (data.sourceRef is string && data.sourceRef.size() <= 256))
        && data.confidence is number
        && data.confidence >= 0
        && data.confidence <= 1
        && data.sensitivity in ["low", "normal", "sensitive"]
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (data.expiresAt == null
          || (data.expiresAt is timestamp && data.expiresAt > request.time))
        && data.userVisible is bool
        && data.confirmedByUser is bool
        && (data.sensitivity != "sensitive"
          || (data.sourceKind in ["user_explicit", "user_corrected"]
            && data.confirmedByUser == true));
    }

    match /users/{uid} {
      // Root profile fields are backend-owned until a validated profile-edit API exists.
      allow read: if isOwner(uid);
      allow create, update, delete: if false;

      match /devices/{deviceId} {
        allow read: if isOwner(uid);
        allow create, update, delete: if false;
      }

      match /projects/{projectId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && validProject(request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if isOwner(uid)
          && validProject(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;
        allow delete: if isOwner(uid);
      }

      match /tasks/{taskId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && validTask(request.resource.data)
          && request.resource.data.source == "user"
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if isOwner(uid)
          && validTask(request.resource.data)
          && request.resource.data.source == resource.data.source
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;
        allow delete: if isOwner(uid);
      }

      match /conversations/{conversationId} {
        // Conversation history is persisted by trusted backend code so clients
        // cannot forge assistant/tool messages or mutate conversation metadata.
        allow read: if isOwner(uid);
        allow create, update, delete: if false;

        match /messages/{messageId} {
          allow read: if isOwner(uid);
          allow create, update, delete: if false;
        }
      }

      match /memories/{memoryId} {
        // Direct client writes are safe here because records are strictly schema-
        // validated, the path is tied to Firebase Auth UID, and only user-entered
        // or user-corrected records are accepted. Retrieved content remains untrusted.
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && validMemory(request.resource.data)
          && request.resource.data.sourceKind == "user_explicit"
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if isOwner(uid)
          && validMemory(request.resource.data)
          && request.resource.data.sourceKind == "user_corrected"
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;
      }

      match /automations/{automationId} {
        // Automation definitions can cause side effects; clients are read-only
        // until a validated mutation API and schema are defined.
        allow read: if isOwner(uid);
        allow create, update, delete: if false;
      }

      match /approvals/{approvalId} {
        // Approval records are created and transitioned by trusted backend code.
        allow read: if isOwner(uid);
        allow create, update, delete: if false;
      }

      match /activity/{activityId} {
        // Audit/activity records are append-oriented and backend-controlled.
        allow read: if isOwner(uid);
        allow create, update, delete: if false;
      }

      match /preferences/{preferenceId} {
        // Keep preferences read-only until their schema and mutation contract exist.
        allow read: if isOwner(uid);
        allow create, update, delete: if false;
      }

      match /notifications/{notificationId} {
        allow read: if isOwner(uid);
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"])
          && request.resource.data.read is bool;
        allow create, delete: if false;
      }
    }

    // Default deny for anything outside the user hierarchy.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
