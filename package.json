{
  "name": "awwab",
  "private": true,
  "version": "0.1.0",
  "description": "Awwab personal AI operating assistant monorepo",
  "scripts": {
    "web:dev": "npm --prefix apps/web run dev",
    "web:build": "npm --prefix apps/web run build",
    "web:typecheck": "npm --prefix apps/web run typecheck",
    "functions:build": "npm --prefix backend/functions run build",
    "functions:typecheck": "npm --prefix backend/functions run typecheck",
    "shared:typecheck": "tsc --noEmit packages/shared/src/contracts.ts",
    "firebase:emulators": "firebase emulators:start --project demo-awwab",
    "firebase:rules:test": "firebase emulators:exec --only firestore --project demo-awwab \"node --test tests/firestore.rules.test.js\"",
    "firebase:callable:test": "firebase emulators:exec --only auth,firestore,functions --project demo-awwab \"node --test tests/functions.callable.test.js\"",
    "agent-core:test": "npm run functions:build && node --test tests/agent-core.test.js"
  },
  "engines": {
    "node": "22"
  },
  "workspaces": [
    "apps/web",
    "backend/functions",
    "packages/shared"
  ],
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.19.0",
    "firebase-tools": "15.31.0"
  }
}
